rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isOwner(resource.data.userId);
    }

    function isIncomingOwner() {
      return isOwner(request.resource.data.userId);
    }
    
    function isValidString(value) {
      return value is string && value.size() > 0;
    }

    function isValidOptionalString(value) {
      return value is string;
    }
    
    function isValidNumber(value) {
      return value is number && value >= 0;
    }
    
    // Employees Collection
    match /employees/{employeeId} {
      allow read, delete: if isAuthenticated() && isDataOwner();
      allow create: if isAuthenticated() && isIncomingOwner()
        && isValidString(request.resource.data.name)
        && isValidOptionalString(request.resource.data.phone)
        && request.resource.data.createdAt is string;
      allow update: if isAuthenticated() && isDataOwner() && isIncomingOwner();
    }

    // Locations Collection
    match /locations/{locationId} {
      allow read, delete: if isAuthenticated() && isDataOwner();
      allow create: if isAuthenticated() && isIncomingOwner()
        && isValidString(request.resource.data.name)
        && request.resource.data.createdAt is string;
      allow update: if isAuthenticated() && isDataOwner() && isIncomingOwner();
    }
    
    // Events Collection
    match /events/{eventId} {
      allow read, delete: if isAuthenticated() && isDataOwner();
      allow create: if isAuthenticated() && isIncomingOwner()
        && isValidString(request.resource.data.date)
        && isValidString(request.resource.data.title);
      allow update: if isAuthenticated() && isDataOwner() && isIncomingOwner();
    }
    
    // Shifts Collection
    match /shifts/{shiftId} {
      allow read, delete: if isAuthenticated() && isDataOwner();
      allow create: if isAuthenticated() && isIncomingOwner()
        && isValidString(request.resource.data.eventId)
        && isValidString(request.resource.data.date)
        && isValidString(request.resource.data.employeeId);
      allow update: if isAuthenticated() && isDataOwner() && isIncomingOwner();
    }
    
    // Payments Collection
    match /payments/{paymentId} {
      allow read, delete: if isAuthenticated() && isDataOwner();
      allow create: if isAuthenticated() && isIncomingOwner();
      allow update: if isAuthenticated() && isDataOwner() && isIncomingOwner();
    }
    
    // Settings Collection
    match /settings/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId
        && isIncomingOwner();
    }
  }
}
